# Build context is the Glyphora monorepo root.
# Kept separate from the existing production Dockerfile until cutover.
FROM dart:3.12.2 AS build
WORKDIR /app
COPY pubspec.lock .
COPY server/backend_server server/backend_server
COPY packages/nom_converter packages/nom_converter
RUN printf '%s\n' \
  'name: glyphora_docker_workspace' \
  'publish_to: none' \
  'environment:' \
  '  sdk: ^3.12.2' \
  'workspace:' \
  '  - packages/nom_converter' \
  '  - server/backend_server' \
  > pubspec.yaml
COPY cloudflare/patch-serverpod-analyzer.dart /app/cloudflare/patch-serverpod-analyzer.dart
RUN dart pub get
RUN dart /app/cloudflare/patch-serverpod-analyzer.dart
WORKDIR /app/server/backend_server
RUN dart compile exe bin/main.dart -o bin/server
FROM alpine:latest
WORKDIR /app
ENV runmode=production
ENV serverid=default
ENV logging=normal
ENV role=monolith
COPY --from=build /runtime/ /
COPY --from=build /app/server/backend_server/bin/server server
COPY --from=build /app/server/backend_server/config/ config/
COPY --from=build /app/server/backend_server/web/ web/
COPY --from=build /app/server/backend_server/migrations/ migrations/
COPY --from=build /app/server/backend_server/lib/src/generated/protocol.yaml lib/src/generated/protocol.yaml
COPY --from=build /app/packages/nom_converter/data/ data/glyphora_nom_converter/
COPY cloudflare/container-entrypoint.sh /app/cloudflare-container-entrypoint.sh
EXPOSE 8080
EXPOSE 8081
EXPOSE 8082
ENTRYPOINT ["/bin/sh", "/app/cloudflare-container-entrypoint.sh"]
