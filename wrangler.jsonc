{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyphora-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-11",
  "containers": [
    {
      "class_name": "GlyphoraServer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GLYPHORA_SERVER", "class_name": "GlyphoraServer" }
    ]
  },
  "exports": {
    "GlyphoraServer": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [
    {
      "binding": "GLYPHORA_PRIVATE_R2",
      "bucket_name": "glyphora-media-private"
    }
  ],
  "vars": {
    "CLOUDFLARE_R2_BUCKET": "glyphora-media",
    "CLOUDFLARE_R2_PUBLIC_HOST": "media.glyphora.net",
    "SMTP_EMAIL": "chengyang1017@gmail.com",
    "GLYPHORA_ADMIN_EMAIL": "chengyang905@gmail.com",
    "CLOUDFLARE_R2_PRIVATE_BUCKET": "glyphora-media-private",
    "GLYPHORA_CLOUDFLARE_PUBLIC_HOST": "glyphora-api.chengyang1017.workers.dev",
    "GLYPHORA_PRIVATE_INGEST_BASE_URL": "https://glyphora-api.chengyang1017.workers.dev"
  },
  "observability": { "enabled": true }
}
